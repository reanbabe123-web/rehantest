@charset "utf-8";

:root { --bg: #0d1526; --bg2: #131e36; --card: #17233f; --tx: #f3eee2; --mu: #a9b0c0; --gold: #c9a96a; --gold2: #e6cf9c; --ln: rgba(201,169,106,.28); --err: #e07a7a; --ok: #7fc8a0; color-scheme: dark; box-sizing: border-box; padding-top: env(safe-area-inset-top,0px); padding-bottom: env(safe-area-inset-bottom,0px); }

@media (prefers-color-scheme: light) {
  :root:not([data-theme="dark"]) { --bg: #f6f2e8; --bg2: #ece5d4; --card: #fffdf7; --tx: #16203a; --mu: #5d6479; --gold: #8f6f2c; --gold2: #6e5320; --ln: rgba(143,111,44,.35); --err: #b23b3b; --ok: #2d7a52; color-scheme: light; }
}

:root[data-theme="dark"] { --bg: #0d1526; --bg2: #131e36; --card: #17233f; --tx: #f3eee2; --mu: #a9b0c0; --gold: #c9a96a; --gold2: #e6cf9c; --ln: rgba(201,169,106,.28); color-scheme: dark; }

* { box-sizing: border-box; }

html { scroll-padding-top: env(safe-area-inset-top,0px); scroll-behavior: smooth; }

body { margin: 0px; background: var(--bg); color: var(--tx); font: 300 16px / 1.65 Jost, system-ui, sans-serif; }

h1, h2, h3 { font-family: "Cormorant Garamond", Georgia, serif; font-weight: 500; margin: 0px; line-height: 1.1; }

button, input, select, textarea { font: inherit; color: inherit; }

body::before { content: ""; position: fixed; inset: 0px 0px auto; height: env(safe-area-inset-top,0px); background: var(--bg); z-index: 60; }

nav { position: sticky; top: env(safe-area-inset-top,0px); z-index: 50; display: flex; align-items: center; gap: 18px; padding: 14px 5vw; background: var(--bg); border-bottom: 1px solid var(--ln); }

.logo { font-family: "Cormorant Garamond", serif; font-size: 26px; font-weight: 600; letter-spacing: 0.06em; color: var(--gold); cursor: pointer; margin-right: auto; }

.logo small { font: 300 11px Jost; letter-spacing: 0.3em; margin-left: 8px; color: var(--mu); }

nav a { cursor: pointer; color: var(--mu); font-size: 14px; letter-spacing: 0.04em; }

nav a:hover { color: var(--gold); }

.btn { display: inline-block; border: 1px solid var(--gold); background: var(--gold); color: rgb(16, 24, 40); padding: 11px 26px; cursor: pointer; font-weight: 500; letter-spacing: 0.05em; transition: 0.2s; text-align: center; text-decoration: none; }

.btn:hover { background: var(--gold2); }

.btn:disabled { opacity: 0.4; cursor: not-allowed; }

.btn.o { background: transparent; color: var(--gold); }

.btn.o:hover { background: var(--gold); color: rgb(16, 24, 40); }

.btn.s { padding: 6px 14px; font-size: 13px; }

.btn.d { border-color: var(--err); color: var(--err); background: transparent; }

:focus-visible { outline: 2px solid var(--gold2); outline-offset: 2px; }

.badge { background: var(--gold); color: rgb(16, 24, 40); border-radius: 99px; font-size: 11px; padding: 1px 7px; margin-left: 4px; }

.hero { min-height: 82vh; display: grid; place-items: center; text-align: center; padding: 9vh 6vw; background: radial-gradient(ellipse at 50% 0,var(--bg2),var(--bg) 70%); border-bottom: 1px solid var(--ln); }

.hero h1 { font-size: clamp(46px, 9vw, 112px); font-weight: 400; letter-spacing: 0.02em; }

.hero h1 em { display: block; font-size: 0.42em; font-style: italic; color: var(--gold); letter-spacing: 0.12em; margin-top: 10px; }

.hero p { max-width: 520px; margin: 22px auto 30px; color: var(--mu); }

.cd { display: flex; gap: 14px; justify-content: center; margin: 26px 0px 34px; }

.cd div { border: 1px solid var(--ln); min-width: 74px; padding: 12px 6px; }

.cd b { display: block; font: 500 34px "Cormorant Garamond", serif; color: var(--gold2); }

.cd span { font-size: 12px; color: var(--mu); }

section { padding: 80px 5vw; }

.wrap { max-width: 1180px; margin: auto; }

.ttl { text-align: center; margin-bottom: 46px; }

.ttl h2 { font-size: clamp(34px, 5vw, 54px); }

.ttl p { color: var(--mu); margin: 8px 0px 0px; }

.ttl::after { content: ""; display: block; width: 60px; height: 1px; background: var(--gold); margin: 20px auto 0px; }

.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 26px; }

.pc { background: var(--card); border: 1px solid var(--ln); display: flex; flex-direction: column; }

.pc .im { background: var(--bg2); padding: 22px; display: grid; place-items: center; }

.pc .im img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; display: block; }

.pc .im:has(img) { padding: 0px; }

.f-prev { margin-top: 8px; display: flex; align-items: center; gap: 12px; }

.f-prev img { width: 96px; height: 96px; object-fit: cover; border: 1px solid var(--ln); }

.pc .im svg { width: 78%; max-width: 210px; filter: drop-shadow(rgba(0, 0, 0, 0.35) 0px 12px 18px); }

.pc .bd { padding: 20px; display: flex; flex-direction: column; gap: 10px; flex: 1 1 0%; }

.pc h3 { font-size: 24px; }

.pr { color: var(--gold2); font: 500 20px "Cormorant Garamond", serif; }

.bar { height: 3px; background: var(--ln); }

.bar i { display: block; height: 100%; background: var(--gold); }

.sm { font-size: 13px; color: var(--mu); }

select, input, textarea { width: 100%; background: var(--bg); border: 1px solid var(--ln); padding: 10px 12px; }

label { display: block; font-size: 13px; color: var(--mu); margin: 12px 0px 4px; }

.steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0px; border: 1px solid var(--ln); }

.steps div { padding: 28px 22px; border-right: 1px solid var(--ln); }

.steps h3 { font-size: 22px; color: var(--gold); margin-bottom: 6px; }

.ov { position: fixed; inset: 0px; background: rgba(5, 9, 18, 0.72); z-index: 80; display: flex; align-items: center; justify-content: center; padding: 16px; overflow: auto; }

.md { background: var(--card); border: 1px solid var(--gold); width: 100%; max-width: 540px; padding: 30px; max-height: 92vh; overflow: auto; }

.md h2 { font-size: 32px; margin-bottom: 6px; }

.tabs { display: flex; border-bottom: 1px solid var(--ln); margin: 14px 0px; }

.tabs a { flex: 1 1 0%; text-align: center; padding: 9px; cursor: pointer; color: var(--mu); font-size: 14px; }

.tabs a.on { color: var(--gold); border-bottom: 2px solid var(--gold); }

.dr { position: fixed; top: 0px; right: 0px; bottom: 0px; width: min(420px, 100%); background: var(--card); border-left: 1px solid var(--gold); z-index: 90; padding-right: 26px; padding-bottom: 26px; padding-left: 26px; overflow: auto; padding-top: calc(26px + env(safe-area-inset-top,0px)); }

.row { display: flex; gap: 10px; align-items: center; justify-content: space-between; padding: 12px 0px; border-bottom: 1px solid var(--ln); }

.qty button { width: 26px; height: 26px; border: 1px solid var(--ln); background: none; cursor: pointer; }

.toast { position: fixed; left: 50%; bottom: calc(24px + env(safe-area-inset-bottom,0px)); transform: translateX(-50%); background: var(--gold); color: rgb(16, 24, 40); padding: 12px 24px; z-index: 99; box-shadow: rgba(0, 0, 0, 0.3) 0px 8px 20px; border-radius: 4px; }

.err { color: var(--err); font-size: 13px; margin-top: 8px; }

.tw { overflow-x: auto; }

table { width: 100%; border-collapse: collapse; font-size: 14px; }

th, td { text-align: left; padding: 11px 10px; border-bottom: 1px solid var(--ln); vertical-align: top; }

th { color: var(--gold); font-weight: 500; }

.st { display: inline-block; padding: 2px 12px; border: 1px solid var(--gold); color: var(--gold2); font-size: 12px; border-radius: 99px; }

.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 18px; margin-bottom: 34px; }

.stats div { border: 1px solid var(--ln); padding: 22px; background: var(--card); }

.stats b { display: block; font: 500 34px "Cormorant Garamond", serif; color: var(--gold2); }

.oc { border: 1px solid var(--ln); background: var(--card); padding: 22px; margin-bottom: 18px; }

footer { text-align: center; padding: 50px 5vw; border-top: 1px solid var(--ln); color: var(--mu); font-size: 14px; }

.two { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

@media (max-width: 640px) {
  nav { gap: 12px; flex-wrap: wrap; }
  .two { grid-template-columns: 1fr; }
  .cd div { min-width: 62px; }
}

@media (prefers-reduced-motion: reduce) {
  * { transition: none !important; scroll-behavior: auto !important; }
}

.ann { background: var(--gold); color: rgb(16, 24, 40); text-align: center; padding: 8px 5vw; font-size: 14px; letter-spacing: 0.04em; }

